# ─── Last Football (web) — environment ───────────────────────────────────────
#
# Copy to .env and fill in. .env is gitignored and must stay that way.
#
# RULE: every VITE_* variable is compiled into the client bundle and is
# readable by anyone who loads the site. Nothing with real authority goes in
# one. Server-only values have no VITE_ prefix and are read by server/index.mjs.
# ─────────────────────────────────────────────────────────────────────────────

# ── Client (public — shipped in the browser bundle) ──────────────────────────

# The Last Football GraphQL API the site reads its content from.
VITE_BACKEND_GRAPHQL=https://api.example.com/graphql/

# Base URL for the site's own API routes.
VITE_API_URL=http://localhost:3000

# Supabase project URL — just a URL, safe to be public.
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase publishable (anon) key. Public by design: it is compiled into the
# bundle, and access is enforced by row-level security, not by this key.
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key

# ── Server only (secret — never add a VITE_ prefix to any of these) ──────────

# Same GraphQL endpoint, read server-side for prerendering and the sync jobs.
BACKEND_GRAPHQL=https://api.example.com/graphql/

# Supabase service key. Full read/write, bypasses row-level security.
SUPABASE_SERVICE_KEY=

# Football data provider keys.
API_FOOTBALL_KEY=
FOOTBALL_DATA_TOKEN=
